{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "视频播放器",
  "version": "0.1.0",
  "identifier": "com.hjf.videoplayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "视频播放器",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421; media-src 'self' asset: http://asset.localhost blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": ["lib/**/*"],
    "fileAssociations": [
      {
        "ext": ["mkv", "mp4", "avi", "mov", "webm", "flv", "ts", "m4v", "wmv", "mpg", "mpeg", "vob"],
        "name": "VideoFile",
        "description": "视频文件",
        "role": "Viewer"
      }
    ],
    "windows": {
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      }
    }
  }
}
